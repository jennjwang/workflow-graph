# ─── Runtime env vars ───────────────────────────────────────────────────────
# Copied into .env for local dev. In Cloud Run these are set by scripts/deploy.sh
# (non-sensitive ones via --set-env-vars, OPENAI_API_KEY via Secret Manager).

# REQUIRED — your OpenAI API key.
OPENAI_API_KEY=sk-...

# OPTIONAL — model name. Defaults to gpt-4o-mini if unset.
# Examples: gpt-4o, gpt-4o-mini, gpt-5.4-2026-03-05
MODEL=gpt-4o

# OPTIONAL — smaller/cheaper model used by all of workflow mapping
# (propose-subtasks, kickoff-question, expand-node, etc.) plus the walker /
# handoff / gap-analysis / actor / typical-workflow endpoints. Defaults to
# gpt-4o-mini. MODEL is reserved for the calls that anchor the session and
# need the better reasoning: /api/generate-tasks, /api/evaluate-answer, and
# /api/chat (the background interview).
# SMALL_MODEL=gpt-4o-mini

# OPTIONAL — port the Express server listens on.
# Local dev defaults to 3001 (Vite proxies /api to it).
# Cloud Run sets this automatically to 8080.
# PORT=3001

# OPTIONAL — directory where /api/session writes JSON responses.
# Local dev defaults to ./sessions.
# Cloud Run mounts a Cloud Storage bucket at /app/data, so set this to /app/data/sessions there.
# SESSIONS_DIR=./sessions

# OPTIONAL — set to "production" to make Express serve the built Vite SPA from ./dist.
# `npm start` sets this automatically; `npm run dev` leaves it unset and uses Vite.
# NODE_ENV=production

# OPTIONAL (REQUIRED for deploy) — Prolific study completion code.
# When set, participants who arrived via a Prolific link (with ?PROLIFIC_PID=...)
# are redirected to https://app.prolific.com/submissions/complete?cc=<code>
# after auto-save on the study-complete screen. Leave unset for non-Prolific runs.
# PROLIFIC_COMPLETION_CODE=

# OPTIONAL — Prolific "screen out" code, used when a participant fails the attention
# checks. They're redirected to /submissions/complete?cc=<code> instead of the normal
# completion code. If unset, falls back to ?cc=NOCODE.
# PROLIFIC_SCREENOUT_CODE=

# OPTIONAL — how many attention checks a participant may answer "yes" to before
# being hard-blocked. Default 0 (any failed attention check screens them out).
# ATTN_CHECK_MAX_FAILS=0


# ─── Deploy-script env vars (only read by scripts/deploy.sh) ────────────────
# These are NOT loaded by the app at runtime — they only matter when you run
# the deploy script. You can set them inline (PROJECT_ID=foo ./scripts/deploy.sh)
# or export them in your shell.

# REQUIRED — your GCP project id.
# PROJECT_ID=

# OPTIONAL — Cloud Run service name. Defaults to "workflow-graph".
# SERVICE_NAME=workflow-graph

# OPTIONAL — Cloud Run region. Defaults to us-central1.
# REGION=us-central1

# OPTIONAL — Cloud Storage bucket for persisted session JSON.
# Defaults to "${SERVICE_NAME}-${PROJECT_ID}".
# BUCKET_NAME=
