# Core
OPENAI_API_KEY=
MODEL=gpt-4o-mini
SMALL_MODEL=gpt-4o-mini

# Retrieval grounding for the upper-level task generator (lib/retrieval.js).
# When RETRIEVAL_ENABLED=true, an LLM call matches the participant to the best
# corpus occupation and that occupation's task statements are injected into the
# generator prompt. Off → generator behaves exactly as before (fail-open).
RETRIEVAL_ENABLED=false
# Model for the occupation-match call (defaults to SMALL_MODEL).
MATCH_MODEL=gpt-4o-mini
# Max task statements injected.
RETRIEVAL_K=20
# How many top occupations to pull statements from.
RETRIEVAL_TOP_OCCUPATIONS=1
# Override the corpus location if needed (default: corpus/occupation-tasks.json).
# CORPUS_PATH=corpus/occupation-tasks.json
